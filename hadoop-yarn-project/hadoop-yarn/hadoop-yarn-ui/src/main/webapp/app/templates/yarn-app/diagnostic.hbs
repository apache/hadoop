<h2>Diagnostics</h2>

<h3>Available Issues</h3>
<ul>
  {{#each model.issues as |issue|}}
    <li>{{issue.fileName}} - {{issue.contentType}}</li>
  {{/each}}
</ul>

<h3>Diagnostics for {{model.appId}}</h3>
<pre>{{model.diagnostic.firstObject.content}}</pre>