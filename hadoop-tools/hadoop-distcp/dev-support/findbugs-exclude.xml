<FindBugsFilter>
  <!--
    The FsPermission of a listing entry is shared with the source FileStatus
    on purpose: one CopyListingFileStatus is built per copied file, and
    copying the permission on every construction and access would add an
    allocation per file without protecting any sensitive state.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.CopyListingFileStatus" />
    <Method name="getPermission" />
    <Bug pattern="EI_EXPOSE_REP" />
  </Match>
  <Match>
    <Class name="org.apache.hadoop.tools.CopyListingFileStatus" />
    <Method name="&lt;init&gt;" />
    <Field name="permission" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>

  <!--
    DistCpOptions is immutable once built, so the context keeps the caller's
    instance rather than a copy.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.DistCpContext" />
    <Method name="&lt;init&gt;" />
    <Field name="options" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>

  <!--
    DistCp is @InterfaceAudience.Public and not final, so it cannot be made
    final without breaking subclasses; its constructor has always been
    allowed to throw.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.DistCp" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="CT_CONSTRUCTOR_THROW" />
  </Match>

  <!--
    ThrottledInputStream is a public, non-final class that may be extended
    outside DistCp; the constructor only asserts that the bandwidth is
    positive.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.util.ThrottledInputStream" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="CT_CONSTRUCTOR_THROW" />
  </Match>

  <!--
    The MapReduce framework hands the TaskAttemptContext to the committer and
    the record reader, which must keep that same instance to work with the
    running task.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.mapred.CopyCommitter" />
    <Method name="&lt;init&gt;" />
    <Field name="taskAttemptContext" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="org.apache.hadoop.tools.mapred.lib.DynamicRecordReader" />
    <Method name="initialize" />
    <Field name="taskAttemptContext" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>

  <!--
    WorkReport carries the exception raised while processing an item back to
    the caller, which needs the original instance to report or rethrow it.
  -->
  <Match>
    <Class name="org.apache.hadoop.tools.util.WorkReport" />
    <Method name="&lt;init&gt;" />
    <Field name="exception" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="org.apache.hadoop.tools.util.WorkReport" />
    <Method name="getException" />
    <Bug pattern="EI_EXPOSE_REP" />
  </Match>
</FindBugsFilter>
