# Downloads what ./mvnw needs before its first real use, with retries.
#
# mvnw fetches maven-wrapper.jar once and without retry. When that download
# fails, it deletes the jar and then reports the misleading
# "Failed to validate Maven wrapper SHA-256" error. maven-wrapper.jar in turn
# downloads the Maven distribution, also without retry. This script does both
# downloads up front and retries each of them, so that a transient failure to
# reach the Maven repository does not fail the build.
#
# TODO: This is a temporary workaround. Remove this script, and the
# "Download Maven wrapper" steps that call it in .github/workflows/, once
# mvnw retries failed downloads itself and Hadoop has upgraded to that
# maven-wrapper release. See https://github.com/apache/maven-wrapper/pull/445
#
# Environment variables:
#   MVNW_BOOTSTRAP_ATTEMPTS  number of attempts per download (default 5)
#   MVNW_BOOTSTRAP_DELAY     seconds to wait after the first failed attempt
#                            (default 10); the wait doubles after each attempt
#   MVNW_BOOTSTRAP_MIRROR    mirror of Maven Central to download
#                            maven-wrapper.jar from when Maven Central fails;
#                            set to an empty value to disable

attempts=${MVNW_BOOTSTRAP_ATTEMPTS:-5}
delay=${MVNW_BOOTSTRAP_DELAY:-10}
central="https://repo.maven.apache.org/maven2/"
mirror=${MVNW_BOOTSTRAP_MIRROR-https://maven-central.storage-download.googleapis.com/maven2}

basedir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P) || exit 1
props="${basedir}/.mvn/wrapper/maven-wrapper.properties"
jar="${basedir}/.mvn/wrapper/maven-wrapper.jar"

function property
{
  sed -n "s/^$1=//p" "${props}" | tr -d '[:space:]'
}

function sha256
{
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

function download
{
  if command -v curl >/dev/null; then
    curl -f -L -sS -o "$2" "$1"
  else
    wget --no-verbose -O "$2" "$1"
  fi
}

## @description  Run a command until it succeeds, up to ${attempts} times
## @param        description of the command, for the log
## @param        command and its arguments
function retry
{
  local what=$1
  local attempt
  local wait=${delay}
  shift

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if "$@"; then
      return 0
    fi
    echo "Attempt ${attempt}/${attempts} to ${what} failed" >&2
    if [[ ${attempt} -lt ${attempts} ]]; then
      echo "Retrying in ${wait} seconds" >&2
      sleep "${wait}"
      wait=$((wait * 2))
    fi
  done
  echo "ERROR: Failed to ${what}" >&2
  return 1
}

## @description  Download maven-wrapper.jar from a URL and verify it
## @param        URL
function fetch_wrapper_jar_from
{
  rm -f "${jar}.tmp"
  # compare the checksums ourselves: `sha256sum -c` skips a malformed line
  # and still exits 0
  if download "$1" "${jar}.tmp"; then
    if [[ "$(sha256 "${jar}.tmp")" == "${wrapper_sha}" ]]; then
      mv "${jar}.tmp" "${jar}"
      return 0
    fi
    echo "SHA-256 of the file downloaded from $1 is not ${wrapper_sha}" >&2
  fi
  rm -f "${jar}.tmp"
  return 1
}

function fetch_wrapper_jar
{
  if fetch_wrapper_jar_from "${wrapper_url}"; then
    return 0
  fi
  # Maven Central sometimes answers GitHub Actions runners with HTTP 429
  # (Too Many Requests), and keeps doing so across retries. The mirror is
  # safe to use, because the jar is verified against the checksum in
  # maven-wrapper.properties.
  if [[ -n "${mirror}" && "${wrapper_url}" == "${central}"* ]]; then
    echo "Trying ${mirror}" >&2
    fetch_wrapper_jar_from "${mirror%/}/${wrapper_url#"${central}"}"
    return $?
  fi
  return 1
}

wrapper_url=$(property wrapperUrl)
wrapper_sha=$(property wrapperSha256Sum)
if [[ -z "${wrapper_url}" || -z "${wrapper_sha}" ]]; then
  echo "ERROR: wrapperUrl or wrapperSha256Sum is not set in ${props}" >&2
  exit 1
fi

if [[ -f "${jar}" && "$(sha256 "${jar}")" == "${wrapper_sha}" ]]; then
  echo "Found ${jar}"
else
  retry "download ${wrapper_url}" fetch_wrapper_jar || exit 1
fi

# maven-wrapper.jar downloads and verifies the Maven distribution
cd "${basedir}" || exit 1
retry "run ./mvnw --version" ./mvnw --version
