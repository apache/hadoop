# project.version
VERSION=$1

# project.build.directory
BASEDIR=$2

# project.build.outputTimestamp; a value of one character or less means unset
TIMESTAMP=${3:--}

function run()
{
  declare res

  echo "\$ ${*}"
  "${@}"
  res=$?
  if [[ ${res} != 0 ]]; then
    echo
    echo "Failed!"
    echo
    exit "${res}"
  fi
}


run "$(dirname "$0")/hadoop-maketar" "${TIMESTAMP}" \
  "hadoop-${VERSION}.tar.gz" "hadoop-${VERSION}"
echo
echo "Hadoop dist tar available at: ${BASEDIR}/hadoop-${VERSION}.tar.gz"
echo