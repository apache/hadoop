<!--
  This is the default configuration for BOS contract tests.

  To run the contract tests, create an auth-keys.xml file in
  src/test/resources/ with your BOS credentials and bucket.
  See core-site.xml for the expected properties.

  DO NOT add auth-keys.xml to version control.
-->
<configuration>

  <property>
    <name>fs.contract.test.fs.bos</name>
    <value/>
    <description>
      The BOS bucket URI for contract tests.
      Set this in auth-keys.xml, e.g. bos://your-bucket-name/test
    </description>
  </property>

  <property>
    <name>fs.contract.test.root-tests-enabled</name>
    <value>false</value>
    <description>
      Root directory tests are disabled by default.
    </description>
  </property>

</configuration>
