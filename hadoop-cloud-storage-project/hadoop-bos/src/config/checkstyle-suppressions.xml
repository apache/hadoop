<suppressions>
    <!-- BaiduBosFileSystem.initialize overrides FileSystem;
         parameter names must match the parent interface. -->
    <suppress checks="HiddenField"
              files="BaiduBosFileSystem\.java"/>
    <!-- BosClientProxyImpl.init overrides BosClientProxy;
         parameter names must match the interface. -->
    <suppress checks="HiddenField"
              files="BosClientProxyImpl\.java"/>
    <!-- BosNativeFileSystemStore exposes protected fields
         for subclass access (hierarchy/non-hierarchy). -->
    <suppress checks="VisibilityModifier"
              files="BosNativeFileSystemStore\.java"/>
    <!-- FileMetadata and UploadPartThread constructors need
         all their parameters for initialization. -->
    <suppress checks="ParameterNumber"
              files="FileMetadata\.java"/>
    <suppress checks="ParameterNumber"
              files="UploadPartThread\.java"/>
    <!-- log4j.properties contains standard Hadoop log
         configuration with long property keys. -->
    <suppress checks="LineLength"
              files="log4j\.properties"/>
</suppressions>
